# ========================================
# Weekly Progress Meeting System (NoSQL)
# ========================================

# 1. Google Sheets Configuration
SPREADSHEET_ID="your_spreadsheet_id_here"
SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", ...}'

# 2. Authentication (NextAuth)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google OAuth. Google sign-in is only offered when both are set.
# These also power Google Calendar sync: the app asks for calendar.events and
# calendar.readonly at sign-in and stores each person's refresh token,
# encrypted with a key derived from NEXTAUTH_SECRET.
#
# Enable "Google Calendar API" in the same Google Cloud project, and add both
# scopes to the OAuth consent screen, or sign-in succeeds and every calendar
# call fails.
#
# Changing NEXTAUTH_SECRET makes stored tokens undecryptable; everyone is shown
# as not connected and has to reconnect.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Domains allowed to self-register via Google, comma separated.
# Leave EMPTY to allow only accounts an admin has already created.
# Self-registered accounts are created inactive and need admin approval.
ALLOWED_SIGNUP_DOMAINS=""

# 3. Seeding
# Password given to the demo accounts created by db:init. Change it.
SEED_PASSWORD="changeme123"

# Set to "true" to show demo-account hints on the login page. Never in production.
NEXT_PUBLIC_SHOW_DEV_TOOLS="false"

# 4. Notification Integrations (Optional, not yet implemented)
LINE_CHANNEL_ACCESS_TOKEN=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM='"Progress Meeting" <your-email@gmail.com>'

# 5. API/Cron keys
# Sent as: Authorization: Bearer <CRON_SECRET>
# Opens every job on /api/cron, including ones added later.
CRON_SECRET="your_cron_secret_here"

# A second, weaker key for /api/cron that may only ask for read jobs
# (currently: open_feedback). Anything else it asks for is refused with 403.
#
# This is the one to hand to an automation that runs outside the lab -- a
# scheduled routine that fetches open feedback for review. A routine holding
# CRON_SECRET instead would gain the power to trigger a backup or send
# reminders the day those jobs are built; this one will not.
#
# Use a DIFFERENT value from CRON_SECRET. The same string in both is not an
# error, it simply means one key that opens everything -- which defeats the
# point of setting this at all. Leave empty to disable the read-only key.
CRON_READ_SECRET=""

# Which Google account's Drive holds files uploaded in the app (the pictures
# people attach to feedback). A service account has no storage quota and can
# never own a file, so this names a real account; an admin connects it once
# from the Settings page.
LAB_DRIVE_EMAIL=""
